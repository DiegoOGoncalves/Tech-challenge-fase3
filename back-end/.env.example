# Porta em que a aplicação Nest.js irá escutar
PORT=3000

# Configuração do PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=blog_db

# TypeORM sincroniza o schema automaticamente (usar apenas em dev)
DB_SYNCHRONIZE=true

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=1h

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
