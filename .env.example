# PostgreSQL
POSTGRES_DB=blog_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_EXTERNAL_PORT=5432

# Backend and frontend published ports
BACKEND_PORT=3000
FRONTEND_PORT=8080

# TypeORM schema synchronization (use false with migrations in production)
DB_SYNCHRONIZE=true

# JWT (use a long random value outside local development)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=1h
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# URL consumed by the browser from the built frontend
VITE_API_URL=http://localhost:3000
